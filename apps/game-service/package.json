{
  "name": "@robo-rally/game-service",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "install-dev": "pnpm --filter @robo-rally/game-service... install --frozen-lockfile --prod=false",
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@robo-rally/game-events": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "tsx": "^4.23.13",
    "typescript": "~7.0.2",
    "vitest": "^4.1.11"
  }
}
