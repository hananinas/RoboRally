{
  "name": "@robo-rally/game-service",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "install-dev": "pnpm --filter @robo-rally/game-service... install --frozen-lockfile --prod=false",
    "dev": "tsx watch --clear-screen=false src/main.ts",
    "build": "rm -rf dist && tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json --resolve-full-paths --resolve-full-extension .js",
    "start": "node dist/main.js",
    "lint": "oxlint --type-aware",
    "test:unit": "vitest run test",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@robo-rally/game-events": "workspace:*",
    "cookie": "^1.0.2",
    "express": "^5.3.0",
    "openid-client": "^6.8.8",
    "socket.io": "^4.8.4",
    "socket.io-adapter": "^2.5.8",
    "neverthrow": "^8.2.0",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "oxlint": "^1.89.0",
    "oxlint-tsgolint": "^7.0.2004",
    "socket.io-client": "^4.8.4",
    "tsc-alias": "^1.9.8",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2",
    "vitest": "^5.0.5"
  }
}
