{
  "name": "@robo-rally/kratos-hydra-ui",
  "version": "0.23.10",
  "private": true,
  "description": "Vendored from ory/kratos-selfservice-ui-node (v26.2.0), to be gradually replaced with a custom app.",
  "homepage": "https://github.com/ory/kratos-selfservice-ui-node#readme",
  "license": "Apache-2.0",
  "author": "Aeneas Rekkas",
  "main": "src/index.ts",
  "files": [
    "lib/*",
    "views/*"
  ],
  "scripts": {
    "install-dev": "pnpm --filter @robo-rally/kratos-hydra-ui... install --frozen-lockfile --prod=false",
    "build": "rm -rf lib/* && npx tsc",
    "serve": "node lib/index.js",
    "start": "nodemon",
    "test": "exit 0",
    "format:check": "prettier --check ."
  },
  "prettier": "ory-prettier-styles",
  "dependencies": {
    "@ory/client": "1.22.66",
    "@ory/elements-markup": "0.9.1",
    "@redtea/format-axios-error": "2.1.1",
    "@robo-rally/theme": "workspace:*",
    "accept-language-parser": "1.5.0",
    "axios": "1.20.0",
    "body-parser": "2.3.0",
    "cookie-parser": "1.4.7",
    "csrf-csrf": "4.0.3",
    "express": "5.3.0",
    "express-handlebars": "9.0.2",
    "express-jwt": "8.5.1",
    "express-winston": "4.2.0",
    "jwks-rsa": "4.1.0",
    "winston": "3.19.0"
  },
  "devDependencies": {
    "@trivago/prettier-plugin-sort-imports": "6.0.2",
    "@types/accept-language-parser": "1.5.8",
    "@types/body-parser": "1.19.6",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/express-handlebars": "6.0.2",
    "@types/handlebars-helpers": "0.5.6",
    "@types/jwt-decode": "3.1.0",
    "@types/node": "26.6.5",
    "license-checker": "25.0.1",
    "nodemon": "3.1.14",
    "ory-prettier-styles": "1.3.0",
    "prettier": "3.9.10",
    "prettier-plugin-packagejson": "3.0.2",
    "ts-node": "10.9.2",
    "tsx": "^4.23.15",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=26.0.0",
    "npm": ">=8.11.0"
  }
}
