{
  "name": "@robo-rally/client",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "install-dev": "pnpm --filter @robo-rally/client... install --frozen-lockfile --prod=false",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint --type-aware",
    "test": "pnpm test:unit && pnpm test:browser",
    "test:browser": "playwright test && playwright test --config playwright.membership.config.ts",
    "test:unit": "vitest run",
    "typecheck": "tsc -b",
    "preview": "vite preview"
  },
  "dependencies": {
    "@robo-rally/game-events": "workspace:*",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^26.6.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "oxlint": "^1.87.0",
    "oxlint-tsgolint": "^7.0.2003",
    "socket.io": "^4.8.3",
    "tsx": "^4.23.13",
    "typescript": "~7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.3"
  }
}
